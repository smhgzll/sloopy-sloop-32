# Copy to config/local.env and edit before REAL hardware builds.
# This file contains local/secret values and is gitignored.

SLOOPY_WIFI_MODE=AP
SLOOPY_WIFI_SSID=Sloopy-Sloop-32
SLOOPY_WIFI_PASSWORD=change-this-password

# Set these after checking your exact ESP32-S3 clone board pinout (BCLK -> PCM5102A BCK, WS -> LCK,
# DOUT -> DIN). 4 / 5 / 6 are free on ESP32-S3 boards; wiring: docs/HARDWARE_TESTS.md.
SLOOPY_I2S_BCLK_GPIO=-1
SLOOPY_I2S_WS_GPIO=-1
SLOOPY_I2S_DOUT_GPIO=-1

# 1: SLOOP is a USB-MIDI device on the board's native USB port (MIDI in / out, SLOOP's web editor
# over USB, as on the FM-1). That port then stops being a serial console / flash port while the
# firmware runs: flash and monitor through the board's UART ("COM") port, or hold BOOT while
# plugging in to flash over native USB. Leave 0 for the first hardware bring-up.
SLOOPY_USB_MIDI=0

# Typical values are /dev/ttyACM0 or /dev/ttyUSB0; confirm on your machine.
SLOOPY_SERIAL_PORT=/dev/ttyACM0
